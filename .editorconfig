# Kairos — solution-wide style + analyzer severities. `dotnet format` enforces this; CI verifies it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,ts,cshtml,css}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Usings & namespaces
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Modern C# preferences (kept as suggestions so they don't break the warnings-as-errors build)
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_qualification_for_field = false:suggestion

# Analyzer severity overrides (justified):
# CA1716 — parameter names colliding with VB reserved words (e.g. `date`/`Date`). Kairos is a
# single-language C# app with no VB interop, so this cross-language rule adds no value.
dotnet_diagnostic.CA1716.severity = none
# CA1848 — LoggerMessage source-gen delegates. A micro-optimization not worth the boilerplate for
# this single-user app's low-frequency logging (e.g. the ~5-min sync cycle).
dotnet_diagnostic.CA1848.severity = none

# EF Core migrations are generated code — don't subject them to analyzers/style rules.
[**/Migrations/*.cs]
generated_code = true

# Test projects: the xUnit `Method_State_Expected` naming convention (mandated by testing-builder)
# uses underscores, which CA1707 would otherwise flag.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit [CollectionDefinition] marker classes are conventionally named "<Thing>Collection".
dotnet_diagnostic.CA1711.severity = none
