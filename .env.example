# ─────────────────────────────────────────────────────────────────────────────
# Kairos environment variables.  Copy to `.env.local` for local dev and fill in.
# `.env.local` is gitignored — NEVER commit real values (this repo is public).
#
# In production these are NOT stored here: they live in Vercel project env vars
# and in GitHub Actions secrets (see docs/DEPLOYMENT.md).
#
# Note: there are no NEXT_PUBLIC_* Supabase vars on purpose. The browser never
# talks to Supabase directly — all DB access goes through Next.js server code
# using the service-role key, which therefore must stay server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# Supabase dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase service-role key (server-only, full DB access — keep secret!)
# Supabase dashboard → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Local default day window / timezone for the schedule view (IANA tz name).
# Optional — defaults to UTC if unset.
KAIROS_TIMEZONE=UTC
