# Consistent line endings across Windows/Linux/CI (the .editorconfig also enforces eol=lf).
* text=auto eol=lf

# Binary/asset types — never normalize.
*.png binary
*.jpg binary
*.ico binary
*.dump binary

# Generated/vendored — keep diffs quiet and out of language stats.
src/Kairos.Web/wwwroot/dist/** linguist-generated=true
**/Migrations/*.Designer.cs linguist-generated=true
