{
  "uid": "kairos-overview",
  "title": "Kairos — Overview",
  "tags": ["kairos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active tasks",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(kairos_active_tasks)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "htmx partial swap latency (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "p50", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(kairos_htmx_partial_swap_seconds_bucket[5m])))" },
        { "refId": "p95", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(kairos_htmx_partial_swap_seconds_bucket[5m])))" },
        { "refId": "p99", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(kairos_htmx_partial_swap_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Postgres hot-path query p95 (by query)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{query}}", "expr": "histogram_quantile(0.95, sum by (le, query) (rate(kairos_postgres_query_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP request rate (ASP.NET)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{http_route}}", "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[5m]))" }
      ]
    }
  ]
}
