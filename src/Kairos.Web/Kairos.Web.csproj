<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Kairos.ServiceDefaults\Kairos.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Kairos.Application\Kairos.Application.csproj" />
    <ProjectReference Include="..\Kairos.Infrastructure\Kairos.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Htmx" Version="1.12.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Runtime tuning lives in the host csproj (CLAUDE.md). Containers misdetect core
         count, so Workstation GC is wrong for a server process. No Native AOT. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Keep the npm tree out of MSBuild globbing (fast builds, no file locks). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Build the Vite front-end bundle as part of dotnet build. Incremental: skipped when the
       manifest is newer than the sources, so the dev inner loop stays fast. -->
  <ItemGroup>
    <ClientAppInput Include="ClientApp\src\**\*" />
    <ClientAppInput Include="ClientApp\package.json;ClientApp\vite.config.ts;ClientApp\tailwind.config.js" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="BeforeBuild" Inputs="@(ClientAppInput)" Outputs="wwwroot\dist\vite-manifest.json">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>
