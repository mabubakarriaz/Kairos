@page
@model Kairos.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Schedule";
    var dayId = $"day-{Model.Date:yyyy-MM-dd}";
    string D(DateOnly d) => d.ToString("yyyy-MM-dd");
}

@* ── Date toolbar ─────────────────────────────────────────────────────────── *@
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
        <div class="seg">
            <a class="seg-btn" href="?date=@D(Model.Date.AddDays(-1))" title="Previous day (j)" aria-label="Previous day">‹</a>
            <a class="seg-btn" href="/" title="Today (t)">Today</a>
            <a class="seg-btn" href="?date=@D(Model.Date.AddDays(1))" title="Next day (k)" aria-label="Next day">›</a>
        </div>
        <div>
            <h1 class="flex items-center gap-2 text-2xl font-bold leading-tight tracking-tight text-ink">
                @Model.Date.ToString("dddd")
                @if (Model.IsToday)
                {
                    <span class="pill-today">Today</span>
                }
            </h1>
            <p class="mt-0.5 flex items-center gap-2 text-sm text-ink-muted">
                @Model.Date.ToString("d MMMM yyyy")
                <span class="pill">UTC</span>
            </p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_20rem]">

    @* Left: the scrollable time-blocked day grid (the swap target lives inside _DayColumn) *@
    <section class="scroll-area max-h-[80vh] overflow-y-auto pr-1">
        <partial name="Partials/_DayColumn" model="Model" />
    </section>

    @* Right: add-a-task-with-a-time-range, plus the best-free-slots panel *@
    <aside class="space-y-5">
        <form method="post"
              hx-post="?handler=AddTask"
              hx-target="#@dayId"
              hx-swap="outerHTML"
              hx-on::after-request="if(event.detail.successful) this.querySelector('#new-task-title').value=''"
              class="card space-y-4 p-5">
            <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-accent/[0.12] text-accent-strong">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                </span>
                <h2 class="text-sm font-semibold text-ink">Add a task</h2>
            </div>
            <input type="hidden" name="Form.Date" value="@D(Model.Date)" />
            <input type="hidden" name="tz" value="UTC" />

            <div>
                <label class="label" for="new-task-title">Title</label>
                <input id="new-task-title" name="Form.Title" class="field w-full" required
                       placeholder="e.g. Write the design doc" />
                <span asp-validation-for="Form.Title" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div class="flex gap-3">
                <div class="flex-1">
                    <label class="label" for="start">Start</label>
                    <input id="start" type="time" name="Form.StartTime" value="09:00" step="900" class="field w-full" required />
                </div>
                <div class="flex-1">
                    <label class="label" for="end">End</label>
                    <input id="end" type="time" name="Form.EndTime" value="10:00" step="900" class="field w-full" required />
                </div>
            </div>

            <div>
                <label class="label" for="estimate">Estimate <span class="font-normal text-ink-faint">(min, optional)</span></label>
                <input id="estimate" type="number" min="1" name="Form.EstimateMinutes" class="field w-full" placeholder="30" />
            </div>

            <span asp-validation-for="Form" class="block text-xs text-red-500"></span>
            <button type="submit" class="btn w-full">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add to schedule
            </button>
        </form>

        <partial name="Partials/_FreeSlotsPanel" model="Model" />

        <p class="px-1 text-xs leading-relaxed text-ink-faint">
            Drag a blue block to reschedule it. Keys:
            <kbd class="rounded border border-hairline bg-raised px-1 py-0.5 font-sans text-[10px] text-ink-muted">j</kbd>/<kbd class="rounded border border-hairline bg-raised px-1 py-0.5 font-sans text-[10px] text-ink-muted">k</kbd> day,
            <kbd class="rounded border border-hairline bg-raised px-1 py-0.5 font-sans text-[10px] text-ink-muted">t</kbd> today,
            <kbd class="rounded border border-hairline bg-raised px-1 py-0.5 font-sans text-[10px] text-ink-muted">n</kbd> new.
        </p>
    </aside>
</div>
