@page
@model Kairos.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Schedule";
    var dayId = $"day-{Model.Date:yyyy-MM-dd}";
    string D(DateOnly d) => d.ToString("yyyy-MM-dd");
}

<div class="mb-4 flex items-center justify-between">
    <div class="flex items-center gap-2">
        <a class="field" href="?date=@D(Model.Date.AddDays(-1))" title="Previous day (j)">‹</a>
        <a class="field" href="/" title="Today (t)">Today</a>
        <a class="field" href="?date=@D(Model.Date.AddDays(1))" title="Next day (k)">›</a>
        <h1 class="ml-3 text-xl font-semibold">@Model.Date.ToString("dddd, d MMMM yyyy")</h1>
        <span class="text-xs text-slate-400">(UTC)</span>
    </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_18rem]">

    @* Left: the scrollable time-blocked day grid (the swap target lives inside _DayColumn) *@
    <section class="max-h-[78vh] overflow-y-auto pr-1">
        <partial name="Partials/_DayColumn" model="Model" />
    </section>

    @* Right: add-a-task-with-a-time-range, plus the best-free-slots panel *@
    <aside class="space-y-6">
        <form method="post"
              hx-post="?handler=AddTask"
              hx-target="#@dayId"
              hx-swap="outerHTML"
              hx-on::after-request="if(event.detail.successful) this.querySelector('#new-task-title').value=''"
              class="space-y-3 rounded-lg border border-slate-200 bg-white p-4">
            <h2 class="text-sm font-semibold text-slate-600">Add a task</h2>
            <input type="hidden" name="Form.Date" value="@D(Model.Date)" />
            <input type="hidden" name="tz" value="UTC" />

            <div>
                <label class="block text-xs text-slate-500" for="new-task-title">Title</label>
                <input id="new-task-title" name="Form.Title" class="field w-full" required
                       placeholder="e.g. Write the design doc" />
                <span asp-validation-for="Form.Title" class="text-xs text-red-600"></span>
            </div>

            <div class="flex gap-2">
                <div class="flex-1">
                    <label class="block text-xs text-slate-500" for="start">Start</label>
                    <input id="start" type="time" name="Form.StartTime" value="09:00" step="900" class="field w-full" required />
                </div>
                <div class="flex-1">
                    <label class="block text-xs text-slate-500" for="end">End</label>
                    <input id="end" type="time" name="Form.EndTime" value="10:00" step="900" class="field w-full" required />
                </div>
            </div>

            <div>
                <label class="block text-xs text-slate-500" for="estimate">Estimate (min, optional)</label>
                <input id="estimate" type="number" min="1" name="Form.EstimateMinutes" class="field w-full" placeholder="30" />
            </div>

            <span asp-validation-for="Form" class="block text-xs text-red-600"></span>
            <button type="submit" class="btn w-full">Add to schedule</button>
        </form>

        <div id="freeslots" class="space-y-2">
            <h2 class="text-sm font-semibold text-slate-600">Best free slots</h2>
            @if (Model.BestSlots.Count == 0)
            {
                <p class="text-xs text-slate-400">No open slots in working hours.</p>
            }
            else
            {
                @foreach (var slot in Model.BestSlots)
                {
                    <div class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-xs text-emerald-800">
                        @slot.StartUtc.ToString("HH:mm")–@slot.EndUtc.ToString("HH:mm") UTC
                        <span class="text-emerald-500">(@((int)slot.Duration.TotalMinutes)m)</span>
                    </div>
                }
            }
        </div>

        <p class="text-xs text-slate-400">Drag a blue block to reschedule it. Keys: <kbd>j</kbd>/<kbd>k</kbd> day, <kbd>t</kbd> today, <kbd>n</kbd> new.</p>
    </aside>
</div>
