@model Kairos.Web.Pages.IndexModel
@{
    string Hm(DateTimeOffset t) => t.ToString("HH:mm");
}

@* Best-3 ranked free slots. Clickable: a slot prefills the add-task form's start/end and focuses
   the title. Rendered both as the live sidebar panel and as an hx-swap-oob target after add/reschedule
   (the oob attribute is inert on initial page load — only honored inside htmx swap responses). *@
<aside id="freeslots" hx-swap-oob="true" class="space-y-2">
    <div class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </svg>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Best free slots</h2>
    </div>

    @if (Model.BestSlots.Count == 0)
    {
        <p class="rounded-lg border border-dashed border-hairline px-3 py-4 text-center text-xs text-ink-faint">
            No open slots in working hours.
        </p>
    }
    else
    {
        @foreach (var slot in Model.BestSlots)
        {
            <button type="button"
                    class="freeslot-chip group animate-pop-in"
                    data-start="@Hm(slot.StartUtc)" data-end="@Hm(slot.EndUtc)"
                    title="Use this slot in the add form"
                    @@click="document.getElementById('start').value = $el.dataset.start; document.getElementById('end').value = $el.dataset.end; document.getElementById('new-task-title').focus()">
                <span class="flex items-center gap-1.5 font-semibold tabular-nums">
                    @Hm(slot.StartUtc)<span class="opacity-50">–</span>@Hm(slot.EndUtc)
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="rounded-md bg-free/[0.15] px-1.5 py-0.5 text-[10px] font-semibold">@((int)slot.Duration.TotalMinutes)m</span>
                    <span class="text-[11px] font-medium opacity-0 transition-opacity duration-150 group-hover:opacity-100">Use →</span>
                </span>
            </button>
        }
    }
</aside>
