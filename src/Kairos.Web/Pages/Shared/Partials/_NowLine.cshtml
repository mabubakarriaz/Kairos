@model Kairos.Web.Pages.IndexModel
@{
    var nowTop = Model.NowTopPx;
}
<div id="now-line-wrap"
     hx-get="?handler=NowLine&date=@Model.Date.ToString("yyyy-MM-dd")&tz=@Model.TimeZoneId"
     hx-trigger="every 30s"
     hx-target="#now-line-wrap"
     hx-swap="outerHTML">
    @if (nowTop is double top)
    {
        <div id="now-line" class="now-line" style="top:@top.ToString("0.##")px"></div>
    }
</div>
